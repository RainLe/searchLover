.reply-card {
  padding: 14px 16px;
  border-radius: 14px;
  background: #FFFFFF;
  margin-bottom: 10px;
  box-shadow: 0 2px 8px rgba(43, 43, 43, 0.05);
}

.reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.reply-tone {
  font-size: 11px;
  padding: 2px 10px;
  border-radius: 10px;
  color: #FF69B4;
  background: #FFF0F5;
}

.reply-copy {
  font-size: 12px;
  color: #FF69B4;
  padding: 2px 6px;
}

.reply-text {
  font-size: 14px;
  line-height: 1.7;
  color: #3A3A3A;
}
