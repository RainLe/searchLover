<view class="score-ring" style="width:{{size}}px;height:{{size}}px;">
  <canvas type="2d" id="ring" class="ring-canvas"></canvas>
  <view class="ring-center">
    <view class="score-line">
      <text class="ring-score">{{displayScore}}</text>
      <text class="ring-unit">%</text>
    </view>
    <text class="ring-level">{{level}}</text>
  </view>
</view>
