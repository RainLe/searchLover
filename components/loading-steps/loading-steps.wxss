.steps {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.step {
  display: flex;
  align-items: center;
  gap: 12px;
  opacity: 0.4;
  transition: opacity 0.3s ease;
}

.step.active,
.step.done {
  opacity: 1;
}

.dot {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #F6E9EE;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step.done .dot {
  background: #FFE1EC;
}

.check {
  color: #FF69B4;
  font-size: 13px;
  font-weight: 700;
}

.pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #FF69B4;
  animation: pulse 1s ease-in-out infinite;
}

.step-text {
  font-size: 14px;
  color: #4A4A4A;
}

.hint {
  display: block;
  margin-top: 22px;
  font-size: 12px;
  color: #9A9A9A;
  line-height: 1.6;
}

@keyframes pulse {
  0% { transform: scale(0.7); opacity: 0.5; }
  50% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(0.7); opacity: 0.5; }
}
