.dimension {
  margin-bottom: 18px;
}

.dimension-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8px;
}

.dimension-label-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
}

.dimension-label {
  font-size: 14px;
  color: #4A4A4A;
}

.dimension-weight {
  font-size: 10px;
  color: #B08A99;
  background: #FBF0F4;
  padding: 1px 6px;
  border-radius: 8px;
}

.dimension-score {
  font-size: 15px;
  font-weight: 600;
  color: #FF69B4;
}

.dimension-track {
  height: 8px;
  border-radius: 4px;
  background: #F6E9EE;
  overflow: hidden;
}

.dimension-fill {
  height: 100%;
  border-radius: 4px;
  background: linear-gradient(90deg, #FFC1D4, #FF69B4);
  transition: width 0.6s ease;
}

.dimension-reason {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  color: #8A8A8A;
  line-height: 1.5;
}
