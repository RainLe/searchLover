page {
  background: #FBF7F5;
}

.page {
  min-height: 100vh;
  padding: 32px 20px calc(32px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  padding: 0 4px 22px;
}

.title {
  display: block;
  font-size: 26px;
  font-weight: 700;
  color: #2B2B2B;
}

.sub {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  color: #9A9A9A;
}

.record {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  background: #FFFFFF;
  border-radius: 18px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 6px 18px rgba(180, 120, 140, 0.06);
}

.record-score {
  width: 64px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.score {
  font-size: 22px;
  font-weight: 700;
  color: #E85A8C;
}

.delta {
  margin-top: 4px;
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 8px;
}

.delta.up {
  color: #4E9A6A;
  background: #EDF8F1;
}

.delta.down {
  color: #C96A42;
  background: #FFF2EC;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.level {
  font-size: 13px;
  font-weight: 600;
  color: #4A4A4A;
}

.date {
  font-size: 10px;
  color: #B5B5B5;
}

.summary {
  display: block;
  font-size: 12px;
  line-height: 1.6;
  color: #8A8A8A;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.record-delete {
  width: 24px;
  height: 24px;
  line-height: 24px;
  text-align: center;
  color: #C9B8BC;
  font-size: 16px;
  flex-shrink: 0;
}

.empty {
  padding: 110px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  font-size: 18px;
  font-weight: 600;
  color: #4A4A4A;
}

.empty-sub {
  margin-top: 10px;
  font-size: 12px;
  color: #9A9A9A;
}

.empty-btn {
  margin-top: 26px;
  padding: 11px 34px;
  border-radius: 22px;
  background: #E85A8C;
  color: #FFFFFF;
  font-size: 13px;
}

.clear-all {
  margin-top: 20px;
  text-align: center;
  font-size: 12px;
  color: #C7B6BB;
  padding: 10px 0;
}
