page {
  background: #FBF7F5;
}

.page {
  min-height: 100vh;
  padding: 20px 20px calc(32px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(180deg, #FFFFFF, #FFF9FB);
  border-radius: 24px;
  padding: 20px 20px 24px;
  margin-bottom: 16px;
  box-shadow: 0 10px 30px rgba(180, 120, 140, 0.09);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-top {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4px;
}

.date {
  font-size: 11px;
  color: #B5B5B5;
}

.stage {
  font-size: 10px;
  color: #B07A8D;
  background: #FFF0F5;
  padding: 3px 10px;
  border-radius: 10px;
}

.ring-wrap {
  margin: 10px 0 4px;
}

.summary {
  font-size: 15px;
  line-height: 1.75;
  color: #3A3A3A;
  text-align: center;
  margin: 6px 12px 14px;
}

.meta-row {
  display: flex;
  gap: 8px;
}

.meta-chip {
  font-size: 10px;
  color: #9A9A9A;
  background: #F8F1F3;
  padding: 4px 10px;
  border-radius: 10px;
}

.safety {
  padding: 18px 6px 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.safety-title {
  font-size: 19px;
  font-weight: 700;
  color: #3A3A3A;
  margin-bottom: 12px;
}

.safety-text {
  font-size: 14px;
  line-height: 1.8;
  color: #6A6A6A;
  text-align: center;
}

.section-card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 18px;
  margin-bottom: 16px;
  box-shadow: 0 6px 20px rgba(180, 120, 140, 0.06);
}

.section-title {
  display: block;
  font-size: 16px;
  font-weight: 700;
  color: #2B2B2B;
  margin-bottom: 14px;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.section-head .section-title {
  margin-bottom: 0;
}

.filters {
  display: flex;
  gap: 4px;
  background: #F8F1F3;
  padding: 3px;
  border-radius: 10px;
}

.filter {
  font-size: 10px;
  color: #9A9A9A;
  padding: 4px 10px;
  border-radius: 8px;
}

.filter.on {
  background: #FFFFFF;
  color: #E85A8C;
  font-weight: 600;
  box-shadow: 0 1px 4px rgba(180, 120, 140, 0.12);
}

.stage-focus {
  background: #FFFBF7;
  border: 1px solid #F8EDE3;
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 16px;
}

.stage-focus-label {
  display: block;
  font-size: 10px;
  color: #B07A53;
  margin-bottom: 4px;
}

.stage-focus-text {
  display: block;
  font-size: 12px;
  line-height: 1.65;
  color: #6A5A50;
}

.dimension-list {
  padding-top: 2px;
}

.step-item {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.step-item:last-child {
  margin-bottom: 0;
}

.step-index {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #FFF0F5;
  color: #E85A8C;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}

.step-body {
  flex: 1;
}

.step-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.step-title {
  font-size: 14px;
  font-weight: 600;
  color: #3A3A3A;
}

.step-principle {
  font-size: 10px;
  color: #B07A8D;
  background: #FFF3F7;
  border: 1px solid #FBE1EA;
  padding: 2px 7px;
  border-radius: 8px;
  flex-shrink: 0;
}

.step-detail {
  display: block;
  font-size: 12px;
  line-height: 1.7;
  color: #8A8A8A;
}

.section-sub {
  display: block;
  font-size: 11px;
  color: #B5B5B5;
  margin-top: -8px;
  margin-bottom: 12px;
}

.principle {
  padding: 14px;
  border-radius: 14px;
  background: #FFFBF7;
  border: 1px solid #F8EDE3;
  margin-bottom: 10px;
}

.principle:last-child {
  margin-bottom: 0;
}

.principle-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.principle-index {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #F7E8D8;
  color: #B07A53;
  font-size: 10px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.principle-name {
  font-size: 13px;
  font-weight: 600;
  color: #6A4A3A;
}

.principle-quote {
  display: block;
  font-size: 12px;
  line-height: 1.7;
  color: #8A7A70;
  margin-bottom: 6px;
}

.principle-apply {
  display: block;
  font-size: 12px;
  line-height: 1.7;
  color: #4A4A4A;
  padding-top: 6px;
  border-top: 1px dashed #F0E1D4;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.quick-chip {
  font-size: 11px;
  line-height: 1;
  color: #B07A8D;
  background: #FFF6F9;
  border: 1px solid #FBE1EA;
  padding: 9px 12px;
  border-radius: 14px;
}

.followup-entry-btn {
  height: 44px;
  border-radius: 14px;
  background: linear-gradient(135deg, #F47BA5, #E85A8C);
  color: #FFFFFF;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 18px rgba(232, 90, 140, 0.22);
}

.feedback {
  padding: 4px 8px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feedback-label {
  font-size: 12px;
  color: #9A9A9A;
}

.feedback-actions {
  display: flex;
  gap: 8px;
}

.feedback-btn {
  font-size: 11px;
  color: #9A9A9A;
  background: #FFFFFF;
  border: 1px solid #F0E4E7;
  padding: 5px 14px;
  border-radius: 12px;
}

.feedback-btn.on {
  color: #E85A8C;
  border-color: #F8BFD2;
  background: #FFF5F8;
}

.actions {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}

.action-btn {
  flex: 1;
  height: 44px;
  border-radius: 14px;
  background: #FFFFFF;
  color: #4A4A4A;
  font-size: 12px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(180, 120, 140, 0.08);
  padding: 0;
  margin: 0;
  line-height: 1;
}

.share-btn {
  border: none;
  background: #FFFFFF;
}

.disclaimer {
  display: block;
  text-align: center;
  font-size: 10px;
  line-height: 1.6;
  color: #B5B5B5;
  padding: 0 16px;
}

.delete-link {
  display: block;
  text-align: center;
  font-size: 11px;
  color: #C7B6BB;
  padding: 16px 0 4px;
}

.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 375px;
  height: 565px;
  pointer-events: none;
}

.empty-page {
  min-height: 100vh;
  padding: 120px 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  font-size: 20px;
  font-weight: 700;
  color: #3A3A3A;
}

.empty-sub {
  margin-top: 12px;
  font-size: 13px;
  color: #9A9A9A;
}

.empty-btn {
  margin-top: 28px;
  padding: 12px 36px;
  border-radius: 24px;
  background: #E85A8C;
  color: #FFFFFF;
  font-size: 14px;
}
