page {
  background: #FBF7F5;
}

.page {
  min-height: 100vh;
  padding: 32px 20px calc(32px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.title {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: #2B2B2B;
  padding: 0 4px;
}

.sub {
  display: block;
  margin-top: 10px;
  margin-bottom: 24px;
  padding: 0 4px;
  font-size: 12px;
  line-height: 1.7;
  color: #9A9A9A;
}

.card {
  background: #FFFFFF;
  border-radius: 18px;
  padding: 18px;
  margin-bottom: 14px;
  box-shadow: 0 6px 18px rgba(180, 120, 140, 0.06);
}

.card-title {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: #3A3A3A;
  margin-bottom: 12px;
}

.item {
  display: block;
  font-size: 12px;
  line-height: 1.9;
  color: #7A7A7A;
}

.clear-btn {
  margin-top: 16px;
  height: 42px;
  border-radius: 12px;
  background: #FFF0F5;
  color: #E85A8C;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footnote {
  display: block;
  padding: 10px 4px;
  font-size: 10px;
  line-height: 1.8;
  color: #B5B5B5;
}
