page {
  background: #FBF7F5;
}

.page {
  min-height: 100vh;
  padding: 28px 20px calc(28px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.intro {
  padding: 0 4px 22px;
}

.intro-title {
  display: block;
  font-size: 26px;
  font-weight: 700;
  color: #2B2B2B;
}

.intro-sub {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  color: #9A9A9A;
}

.intro-note {
  display: inline-block;
  margin-top: 10px;
  font-size: 10px;
  color: #B07A8D;
  background: #FFF3F7;
  border: 1px solid #FBE1EA;
  padding: 3px 9px;
  border-radius: 10px;
}

.mode-tabs {
  display: flex;
  padding: 4px;
  background: #F3E9EA;
  border-radius: 14px;
  margin-bottom: 16px;
}

.mode-tab {
  flex: 1;
  height: 38px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #8A8A8A;
  transition: all 0.2s ease;
}

.mode-tab.on {
  background: #FFFFFF;
  color: #E85A8C;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(180, 120, 140, 0.12);
}

.card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 18px;
  margin-bottom: 18px;
  box-shadow: 0 6px 20px rgba(180, 120, 140, 0.06);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.card-title {
  font-size: 14px;
  font-weight: 600;
  color: #3A3A3A;
}

.card-tip {
  font-size: 11px;
  color: #B5B5B5;
}

.chat-input {
  width: 100%;
  min-height: 180px;
  font-size: 14px;
  line-height: 1.8;
  color: #3A3A3A;
  box-sizing: border-box;
}

.input-placeholder {
  color: #C2B8BB;
  font-size: 13px;
}

.input-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #F5EFF1;
}

.counter {
  font-size: 11px;
  color: #B5B5B5;
}

.clear {
  font-size: 12px;
  color: #E85A8C;
  padding: 2px 6px;
}

.upload-box {
  border: 1px dashed #E7C4CF;
  border-radius: 16px;
  padding: 24px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: #FFFBFD;
}

.upload-icon {
  font-size: 24px;
  color: #E85A8C;
  line-height: 1;
}

.upload-title {
  font-size: 14px;
  font-weight: 600;
  color: #4A4A4A;
}

.upload-sub {
  font-size: 11px;
  color: #B5B5B5;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}

.image-item {
  position: relative;
  width: calc((100% - 16px) / 3);
  height: 96px;
  border-radius: 10px;
  overflow: hidden;
  background: #F6EFF1;
}

.image-thumb {
  display: block;
  width: 100%;
  height: 100%;
}

.image-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.42);
}

.image-mask-text {
  color: #FFFFFF;
  font-size: 11px;
}

.image-badge {
  position: absolute;
  left: 4px;
  bottom: 4px;
  padding: 1px 6px;
  border-radius: 8px;
  background: rgba(255, 105, 180, 0.92);
  color: #FFFFFF;
  font-size: 9px;
}

.image-delete {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 14px;
  line-height: 24px;
  text-align: center;
  z-index: 2;
}

.ocr-progress {
  display: block;
  margin-top: 12px;
  font-size: 12px;
  color: #E85A8C;
}

.image-tip {
  display: block;
  margin-top: 8px;
  font-size: 10px;
  line-height: 1.6;
  color: #B5B5B5;
}

.section {
  padding: 0 4px 18px;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10px;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  color: #3A3A3A;
}

.section-optional {
  font-size: 10px;
  color: #B5B5B5;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chip {
  padding: 7px 16px;
  border-radius: 16px;
  background: #FFFFFF;
  color: #7A7A7A;
  font-size: 12px;
  border: 1px solid #F0E4E7;
}

.chip.on {
  background: #FFF0F5;
  color: #E85A8C;
  border-color: #F8BFD2;
  font-weight: 600;
}

.names-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 0;
}

.names-action {
  font-size: 12px;
  color: #B07A8D;
}

.names-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
}

.name-input {
  flex: 1;
  height: 38px;
  padding: 0 12px;
  border-radius: 10px;
  background: #FFFFFF;
  border: 1px solid #F0E4E7;
  font-size: 13px;
  color: #3A3A3A;
}

.names-divider {
  color: #C9B8BC;
  font-size: 12px;
}

.error-card {
  margin: 0 4px 16px;
  padding: 14px;
  border-radius: 14px;
  background: #FFF4F1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.error-text {
  flex: 1;
  font-size: 12px;
  line-height: 1.6;
  color: #C96A42;
}

.retry {
  font-size: 12px;
  font-weight: 600;
  color: #E85A8C;
  padding: 4px 8px;
}

.action-bar {
  padding: 4px 4px 0;
}

.analyze-btn {
  height: 52px;
  border-radius: 26px;
  background: linear-gradient(135deg, #FF8EB4, #F2557F);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 24px rgba(242, 85, 127, 0.26);
}

.analyze-btn.disabled {
  opacity: 0.55;
  box-shadow: none;
}

.analyze-btn:active {
  transform: scale(0.985);
}

.notice {
  display: block;
  margin-top: 12px;
  text-align: center;
  font-size: 10px;
  color: #B5B5B5;
}

.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(43, 30, 35, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px;
}

.loading-card {
  width: 100%;
  max-width: 320px;
  background: #FFFFFF;
  border-radius: 22px;
  padding: 26px 22px 20px;
  box-shadow: 0 20px 50px rgba(60, 30, 40, 0.22);
}

.loading-title {
  display: block;
  font-size: 17px;
  font-weight: 700;
  color: #2B2B2B;
  margin-bottom: 22px;
}

.pii-note {
  display: block;
  margin-top: 18px;
  font-size: 11px;
  color: #B07A8D;
  background: #FFF5F8;
  padding: 8px 10px;
  border-radius: 8px;
}

.loading-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22px;
  padding-top: 14px;
  border-top: 1px solid #F5EFF1;
}

.elapsed {
  font-size: 12px;
  color: #B5B5B5;
}

.cancel {
  font-size: 13px;
  color: #E85A8C;
  padding: 4px 10px;
}
